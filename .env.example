# Base URL of your Remnawave panel (required)
REMNAWAVE_API_URL=https://remnawave.supervpn.com

# Remnawave API token for authentication (required)
REMNAWAVE_API_TOKEN=your-api-token-here

# Optional cookie auth: semicolon-separated key=value pairs
REMNAWAVE_COOKIES=

# Optional custom HTTP headers sent with every Remnawave API request.
# Useful when the panel is behind a proxy/Cloudflare/protection that requires
# an extra header. Semicolon-separated "Name: Value" pairs; value split on first ":".
# A ";" inside parentheses does not split headers (a User-Agent works as is); elsewhere escape it as "\;".
# Example: REMNAWAVE_HEADERS=X-Api-Key: secret123; X-Custom-Header: value
REMNAWAVE_HEADERS=

# Token from @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# Chat ID
TELEGRAM_CHAT_ID=-1001234567890

# Topic ID in supergroups; 0 = disabled
TELEGRAM_THREAD_ID=0

# Admins allowed to press action buttons
TELEGRAM_ADMIN_IDS=111111111,222222222

# Proxy for Telegram API when api.telegram.org is blocked.
# Schemes: http, https, socks5, socks5h. Format: scheme://[user:pass@]host:port
# Examples:
#  TELEGRAM_PROXY=socks5://user:pass@proxy.example.com:1080
#  TELEGRAM_PROXY=http://user:pass@proxy.example.com:1234
TELEGRAM_PROXY=

# "ru", "en" or "zh"
LANGUAGE=ru

# How often to poll nodes for active connections (seconds)
# Lower = faster detection but more API load.
CHECK_INTERVAL=60

# Should be >= ~2x CHECK_INTERVAL
ACTIVE_IP_WINDOW=120

# Dedupe window per user
COOLDOWN=300

# How long to cache user details from API (seconds)
USER_CACHE_TTL=600

# Fixed extra slots above the user's limit
TOLERANCE=0

# Proportional extra tolerance: threshold = limit + TOLERANCE + floor(limit x multiplier) (0 = disabled, max 100)
TOLERANCE_MULTIPLIER=0

# Fallback when user has no explicit limit (0 = skip)
DEFAULT_DEVICE_LIMIT=0

# Detections required before action is taken
VIOLATION_THRESHOLD=3

# Seconds; counter resets after this window. Must be greater than
# (VIOLATION_THRESHOLD - 1) * (COOLDOWN + CHECK_INTERVAL), or the threshold
# can never be reached and the config is rejected.
VIOLATION_THRESHOLD_WINDOW=3600

# "manual" = Telegram alert with buttons; "auto" = auto-disable + alert
ACTION_MODE=manual

# Minutes; 0 = permanent
AUTO_DISABLE_DURATION=15

# auto mode only: send an informational Telegram alert (no ban) when device count
# exceeds the limit but stays within the tolerance band (limit < devices <= limit+TOLERANCE).
# The ban still fires only above limit+TOLERANCE. No effect in manual mode.
# TOLERANCE here means the full tolerance: TOLERANCE + floor(limit x TOLERANCE_MULTIPLIER).
AUTO_NOTIFY_SOFT=false

# Comma-separated user IDs, persisted in Redis
WHITELIST_USER_IDS=

# Comma-separated node UUIDs to ignore (not counted in reports or decisions).
# Example: IGNORED_NODE_UUIDS=4f2d1f6d-551f-4c97-a25e-058ab935673c,9a8b...
IGNORED_NODE_UUIDS=

# Comma-separated IPs and/or CIDR subnets excluded from device counting.
# Use this to drop node/bridge/relay IPs that show up in user connections.
# Supports IPv4/IPv6 single addresses and CIDR ranges.
# Example: IP_WHITELIST=203.0.113.5,10.0.0.0/8,2001:db8::/32
IP_WHITELIST=

# Minutes; TTL for "Ignore" button action. 0 = permanent (add to persistent whitelist).
# The duration is stored in the button when the alert is sent.
IGNORE_DURATION=0

# Count unique IPv4 /N subnets instead of unique IPs. IPv6 always counted per-IP.
SUBNET_GROUPING=false

# IPv4 prefix length (8..32)
SUBNET_PREFIX_V4=24

# Count unique ASN (provider) instead of IPs/subnets — best signal against subscription sharing.
# IPs without resolvable ASN are each counted as a separate group (safe fallback).
# Takes priority over SUBNET_GROUPING when both are enabled. Requires MaxMind ASN DB.
ASN_GROUPING=false

# MaxMind GeoLite2-ASN database — used for provider names in alerts and for ASN_GROUPING.
# Auto-download + periodic refresh when MAXMIND_LICENSE_KEY is set.
# Get FREE key: https://www.maxmind.com/en/geolite2/signup
MAXMIND_LICENSE_KEY=

# Optional local override; default ./geoip/GeoLite2-ASN.mmdb
# ASN_DATABASE_PATH=/var/lib/geoip/GeoLite2-ASN.mmdb

# Refresh period; minimum 1h
MAXMIND_UPDATE_INTERVAL=168h

# POST URL for violation events (empty = disabled)
WEBHOOK_URL=

# Webhook secret. Signs the body in X-Signature: sha256=<hex> and
# "<X-Timestamp>.<body>" in X-Signature-V2 (verify this one: it also stops
# replays). Empty = no auth headers.
WEBHOOK_SECRET=

# Also send the raw secret in X-Webhook-Secret (legacy). Anyone who sees one
# request learns the secret; set to false if your receiver checks the signature.
WEBHOOK_SECRET_HEADER=true

# Redis connection URL (used for caching, cooldowns, violation counters, whitelist
REDIS_URL=redis://redis:6379

# IANA format, e.g. "Europe/Moscow"
TIMEZONE=UTC

# Send a daily violation report to the Telegram chat (top violators + counts).
# Can also be toggled at runtime via /settings.
DAILY_REPORT=true

# Local time (HH:MM, 24h) to send the daily report, in TIMEZONE. Restart required to change.
DAILY_REPORT_TIME=21:00

# Check GitHub once a day for a new release and announce it in the chat, once per version.
# Can also be toggled at runtime via /settings.
UPDATE_CHECK=true

# Traffic monitoring: compare each user's daily traffic with their own usual volume
# (14-day median) and alert on spikes and persistently high traffic. One statistics
# request every 30 minutes for all nodes (plus a light node-list request before it);
# needs the bandwidth-stats:node-usage scope.
# All values except TRAFFIC_IGNORED_NODE_UUIDS can also be changed at runtime via /settings.
TRAFFIC_MONITOR=true

# A day is a spike when its traffic >= max(TRAFFIC_SPIKE_FACTOR x usual volume, TRAFFIC_SPIKE_MIN_GB)
TRAFFIC_SPIKE_FACTOR=10
TRAFFIC_SPIKE_MIN_GB=150

# Persistently high: at least TRAFFIC_HEAVY_DAYS of the last 7 days with >= TRAFFIC_HEAVY_GB (0 = rule off)
TRAFFIC_HEAVY_GB=200
TRAFFIC_HEAVY_DAYS=5

# Comma-separated node UUIDs whose traffic is not counted, on top of IGNORED_NODE_UUIDS
TRAFFIC_IGNORED_NODE_UUIDS=

# Log level: trace, debug, info, warn, error (can be changed in /settings)
LOG_LEVEL=info

# Log format: text or json (restart only)
LOG_FORMAT=text

# Optional HTTP liveness endpoint /healthz. Set host:port (e.g. :8080) to enable; empty = disabled.
# When enabled you can wire the healthcheck in docker-compose.yml.
HEALTH_ADDR=
